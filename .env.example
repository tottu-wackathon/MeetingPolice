# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true
CORS_ORIGINS=

# AWS
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
COMPREHEND_LANGUAGE=ja

# Vonage Video API (JWT Authentication)
VONAGE_APPLICATION_ID=
VONAGE_API_KEY=
VONAGE_PRIVATE_KEY_PATH=secrets/vonage_private.key

# Frontend (Vite) - Vonage静的接続用（必要なら設定）
VITE_VONAGE_APP_ID=
VITE_VONAGE_SESSION_ID=
VITE_VONAGE_TOKEN=

# Frontend URLs
SESSION_APP_URL=
ADMIN_APP_URL=
